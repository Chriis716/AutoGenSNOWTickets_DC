$InstanceUrl = 'https://yourinstance.service-now.com'
$Thumbprint  = 'YOUR_CERT_THUMBPRINT'

$Cert = Get-Item "Cert:\CurrentUser\My\$Thumbprint"

$Headers = @{
    Accept = 'application/json'
}

$TestUri = "$InstanceUrl/api/now/table/change_request?sysparm_limit=1"

Invoke-RestMethod `
    -Method Get `
    -Uri $TestUri `
    -Certificate $Cert `
    -Headers $Headers `
    -ErrorAction Stop
